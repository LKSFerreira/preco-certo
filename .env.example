# =============================================================================
# Variáveis de Ambiente - Sem Susto
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env não é commitado.
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente Operacional
# -----------------------------------------------------------------------------
# Ambientes oficiais desta fase:
# - local
# - producao
#
# Antes do cutover do PostgreSQL remoto, a produção deve manter:
# - APP_ENV=producao
# - VITE_APP_ENV=producao
# - VITE_USAR_BANCO_POSTGRES=false
APP_ENV=local
VITE_APP_ENV=local

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Fonte de verdade da conexão do backend e dos scripts sensíveis.
# Em desenvolvimento local, o Docker Compose aponta para o container database.
# No futuro cutover, a produção continuará usando esta variável, agora apontando
# para o PostgreSQL gerenciado na Supabase.
DATABASE_URL=postgresql://postgres:postgres@db:5432/sem_susto

# Scripts sensíveis do banco
# INIT_DB_IMPORTAR_DADOS:
# - local: padrão true
# - producao: padrão false
INIT_DB_IMPORTAR_DADOS=true
INIT_DB_RESETAR_BANCO=false

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------
# Variáveis SEM prefixo VITE_ ficam apenas no servidor.
# Variáveis COM prefixo VITE_ são expostas no bundle JS do browser.
# Nunca coloque segredos com prefixo VITE_.
API_SECRET=seu_segredo_aqui

# -----------------------------------------------------------------------------
# Groq - LLM para leitura de rótulos
# -----------------------------------------------------------------------------
GROQ_TOKEN=gsk_...

# -----------------------------------------------------------------------------
# Bluesoft Cosmos (API de Produtos)
# -----------------------------------------------------------------------------
COSMOS_TOKEN=sua_chave_cosmos

# -----------------------------------------------------------------------------
# Feature Flags do Cliente
# -----------------------------------------------------------------------------
# Padrão atual:
# - Local: IndexedDB + PostgreSQL local
# - Produção atual (antes do cutover): IndexedDB sem PostgreSQL remoto
VITE_USAR_LOCALSTORAGE=true
VITE_USAR_BANCO_POSTGRES=true

# -----------------------------------------------------------------------------
# Gateways de Pagamento
# -----------------------------------------------------------------------------
# Mercado Pago -> mercado_pago
# PagBank -> pagbank
# Mock automatizado -> mockado
# Nubank failover manual -> nubank_failover
GATEWAY_PAGAMENTO_BACKEND=mockado
VITE_WHATSAPP_SUPORTE=5517996510506

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-...

# PagBank
PG_ACCESS_TOKEN=seu_access_token

# -----------------------------------------------------------------------------
# Observação sobre Supabase
# -----------------------------------------------------------------------------
# Nesta fase, a Supabase será usada apenas como PostgreSQL gerenciado
# no futuro cutover. Não usamos SDK, Auth ou anon key no frontend.
