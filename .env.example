# =============================================================================
# Variáveis de Ambiente - Sem Susto
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NÃO é commitado (está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# ⚠️  SEGURANÇA: Variáveis SEM prefixo VITE_ ficam APENAS no servidor.
#     Variáveis COM prefixo VITE_ são expostas no bundle JS do browser.
#     NUNCA coloque chaves de API com prefixo VITE_.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Groq - LLM para leitura de rótulos (Free Tier Generoso)
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://console.groq.com/keys
# Modelos utilizados: Llama 4 Scout (Vision) + Llama 3.1 8B (Texto)
# ⚠️  SEM VITE_ — chave fica no servidor (api/ia/analisar.ts)
GROQ_TOKEN=gsk_...

# -----------------------------------------------------------------------------
# Bluesoft Cosmos (API de Produtos)
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://cosmos.bluesoft.com.br/api
# ⚠️  SEM VITE_ — chave fica no servidor (api/cosmos/gtin/[codigo].ts)
COSMOS_TOKEN=sua_chave_cosmos

# -----------------------------------------------------------------------------
# Tokens Premium (Proteção do endpoint /api/tokens/gerar)
# -----------------------------------------------------------------------------
# Segredo compartilhado para autenticar chamadas internas.
# Gere um valor aleatório: openssl rand -hex 32
API_SECRET=seu_segredo_aqui

# -----------------------------------------------------------------------------
# Supabase (Banco de Dados + Auth)
# -----------------------------------------------------------------------------
# Crie um projeto em: https://supabase.com
# Encontre essas chaves em: Project Settings > API
# Nota: VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY são públicas por design
# (Supabase usa Row Level Security para proteger os dados)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui

# -----------------------------------------------------------------------------
# PostgreSQL Local (Desenvolvimento apenas)
# -----------------------------------------------------------------------------
# Usado pelo Docker Compose para desenvolvimento local.
# Em produção, usamos Supabase e essas variáveis são ignoradas.
DATABASE_URL=postgresql://postgres:postgres@db:5432/sem_susto

# -----------------------------------------------------------------------------
# Feature Flags (Controle de Serviços)
# -----------------------------------------------------------------------------
# Defina como "false" para desativar. Qualquer outro valor (ou ausência) = true.
# Em produção, se a variável NÃO existir, o comportamento padrão é ATIVADO.

# APIs Externas
VITE_USAR_API_GROQ=true
VITE_USAR_API_COSMOS=true
VITE_USAR_API_OPEN_FOOD_FACTS=true


# Storage / Persistência
VITE_USAR_LOCALSTORAGE=true
VITE_USAR_BANCO_POSTGRES=true

# -----------------------------------------------------------------------------
# EM CASO DE FALHA NO GATEWAY DE PAGAMENTO
# Podemos facilmente trocar para outro gateway de pagamento
# alterando apenas as variáveis de ambiente abaixo
# Mercado Pago (Pagamentos PIX) -> mercado_pago
# PagBank (Pagamentos PIX) -> pagbank
# Mock -> mockado
# -----------------------------------------------------------------------------
VITE_GATEWAY_PAGAMENTO=mockado

# -----------------------------------------------------------------------------
# Mercado Pago (Pagamentos PIX)
# -----------------------------------------------------------------------------
# ⚠️  SEM VITE_ — chave fica no servidor (api/pagamentos/pix.ts)
MP_ACCESS_TOKEN=APP_USR-...

# -----------------------------------------------------------------------------
# PagBank (Pagamentos PIX)
# -----------------------------------------------------------------------------
# ⚠️  SEM VITE_ — chave fica no servidor (api/pagamentos/pix.ts)
PG_APP_ID=sua_app_id
PG_APP_KEY=sua_app_key
