{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/produtos/:codigo",
      "destination": "/api/produtos/[codigo]"
    },
    {
      "source": "/api/cosmos/gtin/:codigo",
      "destination": "/api/cosmos/gtin/:codigo"
    },
    {
      "source": "/api/ia/analisar",
      "destination": "/api/ia/analisar"
    },
    {
      "source": "/api/tokens/gerar",
      "destination": "/api/tokens/gerar"
    },
    {
      "source": "/api/tokens/ativar",
      "destination": "/api/tokens/ativar"
    },
    {
      "source": "/api/tokens/consultar",
      "destination": "/api/tokens/consultar"
    },
    {
      "source": "/api/pagamentos/pix",
      "destination": "/api/pagamentos/pix"
    },
    {
      "source": "/api/pagamentos/status",
      "destination": "/api/pagamentos/status"
    },
    {
      "source": "/api/pagamentos/confirmar",
      "destination": "/api/pagamentos/confirmar"
    },
    {
      "source": "/api/pagamentos/manual/solicitar",
      "destination": "/api/pagamentos/manual/solicitar"
    },
    {
      "source": "/api/pagamentos/manual/aprovar",
      "destination": "/api/pagamentos/manual/aprovar"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.semsusto.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, X-API-Secret, X-Premium-Token"
        }
      ]
    }
  ]
}
